---
apiVersion: trino.stackable.tech/v1alpha2
kind: TrinoCatalog
metadata:
  name: lakehouse
  labels:
    trino: trino
spec:
  connector:
    iceberg:
      catalog:
        rest:
          hostname: hive-metastore-default-headless
          port: 9001
          tls: null
          path: /iceberg
          authentication:
            oAuth2:
              server:
                hostname: keycloak.$NAMESPACE.svc.cluster.local
                port: 8443
                path: /realms/test/protocol/openid-connect/token
                tls:
                  verification:
                    server:
                      caCert:
                        secretClass: tls
              clientCredentials:
                secretName: trino-client-credentials
      s3:
        reference: garage
---
apiVersion: trino.stackable.tech/v1alpha1
kind: TrinoCluster
metadata:
  name: trino
spec:
  image:
{% if test_scenario['values']['trino-l'].find(",") > 0 %}
    custom: "{{ test_scenario['values']['trino-l'].split(',')[1] }}"
    productVersion: "{{ test_scenario['values']['trino-l'].split(',')[0] }}"
{% else %}
    productVersion: "{{ test_scenario['values']['trino-l'] }}"
{% endif %}
    pullPolicy: IfNotPresent
  clusterConfig:
    catalogLabelSelector:
      matchLabels:
        trino: trino
{% if lookup('env', 'VECTOR_AGGREGATOR') %}
    vectorAggregatorConfigMapName: vector-aggregator-discovery
{% endif %}
  coordinators:
    config:
      logging:
        enableVectorAgent: {{ lookup('env', 'VECTOR_AGGREGATOR') | length > 0 }}
    roleGroups:
      default:
        replicas: 1
  workers:
    config:
      gracefulShutdownTimeout: 120s # Let the test run faster, but allow for slow queries
      logging:
        enableVectorAgent: {{ lookup('env', 'VECTOR_AGGREGATOR') | length > 0 }}
    roleGroups:
      default:
        replicas: 1
